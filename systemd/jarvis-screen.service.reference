[Unit]
Description=Jarvis Anzeigen-Server (RGB565-Karten fuer das ESP32-Display)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/openclaw/.local/share/jarvis-screen
ExecStart=/usr/bin/python3 /home/openclaw/.local/share/jarvis-screen/serve.py --host 0.0.0.0 --port 8770
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
