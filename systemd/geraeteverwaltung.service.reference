[Unit]
Description=Geraeteverwaltung im Browser (Alexa-aehnliche Oberflaeche, ioBroker)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/openclaw/.local/share/alexa-direct
Environment=IOBROKER_SIMPLE_API=http://192.168.178.24:8087
Environment=PANEL_HOST=0.0.0.0
Environment=PANEL_PORT=8088
Environment=PYTHONPATH=/home/openclaw/.local/share/alexa-direct
ExecStart=/home/openclaw/.local/share/jarvis-realtime-bridge/.venv/bin/python /home/openclaw/.local/share/alexa-direct/panel.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
