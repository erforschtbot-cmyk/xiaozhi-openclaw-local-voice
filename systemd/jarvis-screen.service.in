[Unit]
Description=Jarvis Anzeigen-Server (RGB565-Karten fuer das ESP32-Display)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@SCREEN_DIR@
ExecStart=@SCREEN_DIR@/.venv/bin/python @SCREEN_DIR@/serve.py --host 0.0.0.0 --port 8770
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
