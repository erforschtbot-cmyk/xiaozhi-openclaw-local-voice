+bool LcdDisplay::ShowFullscreenImage(std::unique_ptr<LvglImage> image) {
+    if (image == nullptr) {
+        return false;
+    }
+    DisplayLockGuard lock(this);
+    if (!setup_ui_called_ || preview_image_ == nullptr) {
+        ESP_LOGW(TAG, "ShowFullscreenImage() called before SetupUI()");
+        return false;
+    }
+
+    auto img_dsc = image->image_dsc();
+    if (img_dsc == nullptr || img_dsc->header.w <= 0 || img_dsc->header.h <= 0) {
+        ESP_LOGE(TAG, "ShowFullscreenImage(): Bild ohne gueltige Masse");
+        return false;
+    }
+
+    // Kein Automatik-Ausblenden wie bei der Vorschau: die Karte bleibt stehen,
+    // bis sie ersetzt oder ausgeblendet wird.
+    if (preview_timer_ != nullptr) {
+        esp_timer_stop(preview_timer_);
+    }
+    if (gif_controller_) {
+        gif_controller_->Stop();
+    }
+    lv_obj_add_flag(emoji_box_, LV_OBJ_FLAG_HIDDEN);
+
+    // Bewusst derselbe Weg wie bei der funktionierenden Vorschau: vorhandenes
+    // Bildobjekt, nur groesser und ohne Ausblend-Timer. Ein eigener Layer mit
+    // deckendem Hintergrund hat auf diesem Panel nur Schwarz gezeigt.
+    preview_image_cached_ = std::move(image);
+    auto dsc = preview_image_cached_->image_dsc();
+    lv_obj_set_size(preview_image_, width_, height_);
+    lv_obj_align(preview_image_, LV_ALIGN_CENTER, 0, 0);
+    lv_image_set_src(preview_image_, dsc);
+    // Einpassen statt verzerren (bei 1:1-Vorlagen ist der Faktor 256).
+    lv_coord_t zoom_w = (lv_coord_t)((int32_t)width_ * 256 / dsc->header.w);
+    lv_coord_t zoom_h = (lv_coord_t)((int32_t)height_ * 256 / dsc->header.h);
+    lv_image_set_scale(preview_image_, zoom_w < zoom_h ? zoom_w : zoom_h);
+    lv_obj_remove_flag(preview_image_, LV_OBJ_FLAG_HIDDEN);
+    lv_obj_move_foreground(preview_image_);
+    return true;
+}
+
+void LcdDisplay::HideFullscreenImage() {
+    DisplayLockGuard lock(this);
+    if (preview_image_ == nullptr) {
+        return;
+    }
+    if (preview_timer_ != nullptr) {
+        esp_timer_stop(preview_timer_);
+    }
+    // Alte Groesse wiederherstellen, sonst belegt das Bildobjekt weiter die
+    // ganze Flaeche und verdraengt das Gesicht.
+    lv_obj_set_size(preview_image_, width_ / 2, height_ / 2);
+    lv_obj_align(preview_image_, LV_ALIGN_CENTER, 0, 0);
+    lv_obj_add_flag(preview_image_, LV_OBJ_FLAG_HIDDEN);
+    preview_image_cached_.reset();
+    if (emoji_box_ != nullptr) {
+        lv_obj_remove_flag(emoji_box_, LV_OBJ_FLAG_HIDDEN);
+    }
+    if (gif_controller_) {
+        gif_controller_->Start();
+    }
+}
