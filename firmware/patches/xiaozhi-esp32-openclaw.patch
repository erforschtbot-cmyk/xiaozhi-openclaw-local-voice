+    void Tick();
+    void SetFaceState(FaceState state);
+    void ApplyMood(const char* emotion);
+    void ScheduleBlink(int64_t now_us);
+    void ScheduleGaze(int64_t now_us);
+
+    lv_obj_t* face_root_ = nullptr;
+    std::array<lv_obj_t*, 2> eyes_{};
+    lv_obj_t* mouth_arc_ = nullptr;
+    std::array<lv_obj_t*, 3> mouth_bars_{};
+    lv_timer_t* face_timer_ = nullptr;
+
+    FaceState face_state_ = FaceState::Idle;
+    Tween eye_height_{100, 100, 100};
+    Tween eye_width_{100, 100, 100};
+    Tween gaze_x_{};
+    Tween gaze_y_{};
+    Tween smile_{24, 24, 24};
+    Tween red_{83, 83, 83};
+    Tween green_{215, 215, 215};
+    Tween blue_{255, 255, 255};
+    int64_t last_tick_us_ = 0;
+    int64_t next_blink_us_ = 0;
+    int64_t next_gaze_us_ = 0;
+    uint16_t blink_elapsed_ms_ = 0;
+    uint8_t blink_phase_ = 0;
+    uint32_t tick_count_ = 0;
+    uint32_t rng_ = 0x9d2c5680;
+
+    // Last values actually submitted to LVGL. Geometry setters already reject
+    // equal values internally, but style setters do not: they refresh styles
+    // and invalidate the object even when the value is unchanged.
+    uint32_t rendered_color_ = UINT32_MAX;
+    int32_t rendered_tilt_ = INT32_MIN;
+    int32_t rendered_curve_ = INT32_MIN;
+    int8_t rendered_mouth_mode_ = -1;
+    std::array<int32_t, 2> rendered_eye_x_{INT32_MIN, INT32_MIN};
+    std::array<int32_t, 2> rendered_eye_y_{INT32_MIN, INT32_MIN};
+    std::array<int32_t, 2> rendered_eye_w_{INT32_MIN, INT32_MIN};
+    std::array<int32_t, 2> rendered_eye_h_{INT32_MIN, INT32_MIN};
+    std::array<int32_t, 3> rendered_bar_x_{INT32_MIN, INT32_MIN, INT32_MIN};
+    std::array<int32_t, 3> rendered_bar_y_{INT32_MIN, INT32_MIN, INT32_MIN};
+    std::array<int32_t, 3> rendered_bar_w_{INT32_MIN, INT32_MIN, INT32_MIN};
+    std::array<int32_t, 3> rendered_bar_h_{INT32_MIN, INT32_MIN, INT32_MIN};
+};
