+
+private:
+    enum class FaceState : uint8_t { Idle, Connecting, Listening, Speaking };
+
+    struct Tween {
+        int32_t from = 0;
+        int32_t to = 0;
+        int32_t value = 0;
+        uint16_t elapsed_ms = 1;
+        uint16_t duration_ms = 1;
+    };
