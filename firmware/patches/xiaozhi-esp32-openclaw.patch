+void Application::HandleStuckWatchdog() {
+    const DeviceState state = GetDeviceState();
+
+    // Reset the per-state counter whenever the state changes.
+    if (state != watchdog_last_state_) {
+        watchdog_last_state_ = state;
+        watchdog_state_seconds_ = 0;
+    } else if (watchdog_state_seconds_ < 1000000) {
+        watchdog_state_seconds_++;
+    }
+
+    watchdog_idle_seconds_ = protocol_ ? protocol_->SecondsSinceLastIncoming() : 0;
+
+    // Only conversation states are guarded. Idle/wifi/activating/upgrading are
+    // never touched, and fatal_error must stay untouched.
+    //
+    // Thresholds are deliberately generous: they must not disturb normal turns,
+    // including tool consults that stream nothing to the device while running.
+    // Tune only with a full test-plan pass afterwards.
+    constexpr int kSpeakingIdleTimeoutS = 60;
+    constexpr int kListeningIdleTimeoutS = 120;
+    constexpr int kConnectingTimeoutS = 15;
+
+    bool stalled = false;
+    const char* reason = "";
+
+    switch (state) {
+        case kDeviceStateSpeaking:
+            // While speaking the server streams audio/TTS events continuously.
+            // A long silence means the answer is dead even though the socket is warm.
+            if (watchdog_idle_seconds_ >= kSpeakingIdleTimeoutS) {
+                stalled = true;
+                reason = "no server audio while speaking";
+            }
+            break;
+        case kDeviceStateListening:
+            // Listening means the device is waiting for the server. Silence for
+            // this long means the turn will never come back.
+            if (watchdog_idle_seconds_ >= kListeningIdleTimeoutS) {
+                stalled = true;
+                reason = "no server activity while listening";
+            }
+            break;
+        case kDeviceStateConnecting:
+            if (watchdog_state_seconds_ >= kConnectingTimeoutS) {
+                stalled = true;
+                reason = "audio channel did not open";
+            }
+            break;
+        default:
+            break;
+    }
+
+    if (!stalled) {
+        return;
+    }
+
+    ESP_LOGW(TAG,
+             "Stuck watchdog: state=%s in_state=%ds idle=%ds (%s) -> idle",
+             DeviceStateMachine::GetStateName(state), watchdog_state_seconds_,
+             watchdog_idle_seconds_, reason);
+
+    if (state == kDeviceStateSpeaking) {
+        AbortSpeaking(kAbortReasonNone);
+    }
+    // Drop deferred work so the wake word path is clean again, then tear the
+    // dead channel down; closing triggers the idle transition as well.
+    tts_stream_end_pending_ = false;
+    pending_listening_start_ = false;
+    if (protocol_) {
+        protocol_->CloseAudioChannel(false);
+    }
+    SetDeviceState(kDeviceStateIdle);
+    watchdog_state_seconds_ = 0;
+}
