+void CircularStrip::WritePixel(int index, StripColor color) {
+    if (color_scale_ < 100) {
+        auto scale = [this](uint8_t value) -> uint8_t {
+            if (value == 0) {
+                return 0;
+            }
+            if (color_scale_ == 0) {
+                return 0;
+            }
+            // Gerundet, damit die sichtbare Helligkeit jeder Stufe exakt der
+            // bisherigen Rechnung entspricht (Abschneiden verloere bis zu
+            // zwei Kanalwerte).
+            uint16_t scaled = (static_cast<uint16_t>(value) * color_scale_ + 50) / 100;
+            // Nie ganz auf 0 fallen, solange die Stufe an ist: sonst
+            // verschwaende die Zustandsfarbe bei kleiner Helligkeit und der
+            // Ring wuerde im Takt der Animation flackern.
+            return scaled == 0 ? 1 : static_cast<uint8_t>(scaled);
+        };
+        color.red   = scale(color.red);
+        color.green = scale(color.green);
+        color.blue  = scale(color.blue);
+    }
+    led_strip_set_pixel(led_strip_, index, color.red, color.green, color.blue);
+}
+
+void CircularStrip::WritePixelRaw(int index, StripColor color) {
+    led_strip_set_pixel(led_strip_, index, color.red, color.green, color.blue);
+}
+
+void CircularStrip::BreatheSmooth(StripColor low, StripColor high, int duration_ms) {
+    if (duration_ms < 100) {
+        duration_ms = 100;
+    }
+    breathe_start_us_ = esp_timer_get_time();
+    breathe_err_[0] = 0.0f;
+    breathe_err_[1] = 0.0f;
+    breathe_err_[2] = 0.0f;
+
+    const int   scale = color_scale_;
+    const uint8_t lo[3] = {low.red, low.green, low.blue};
+    const uint8_t hi[3] = {high.red, high.green, high.blue};
+
+    // Feste Bildrate, unabhaengig von der Helligkeit. Sie muss hoch genug
+    // sein, dass das Auge die geditherten Werte mitteln kann: bei 8 % liegen
+    // zwischen zwei echten LED-Werten 15 ms - mit 16-ms-Frames verteilt sich
+    // der Rundungsrest sauber.
+    StartStripTask(16, [this, lo, hi, duration_ms, scale]() {
+        const int64_t now = esp_timer_get_time();
+        double phase = static_cast<double>(now - breathe_start_us_) /
+                       (static_cast<double>(duration_ms) * 1000.0);
+        if (phase < 0.0) {
+            phase = 0.0;
+        }
+        // Dreieckswelle: 0 -> 1 -> 0, Periode 2.0
+        double p = std::fmod(phase, 2.0);
+        if (p < 0.0) {
+            p += 2.0;
+        }
+        if (p > 1.0) {
+            p = 2.0 - p;
+        }
+
+        uint8_t out[3];
+        for (int c = 0; c < 3; c++) {
+            double target = lo[c] + (static_cast<double>(hi[c]) - lo[c]) * p;
+            if (scale < 100) {
+                target = target * scale / 100.0;
+            }
+            // Temporal-Dithering: den Fehler zum gerundeten Wert mitnehmen,
+            // statt ihn zu verwerfen. Dadurch schwankt die Ausgabe um den
+            // Sollwert und wirkt gemittelt feiner als die 8 Bit der LED.
+            const double with_err = target + breathe_err_[c];
+            double rounded = std::floor(with_err + 0.5);
+            if (rounded < 0.0) {
+                rounded = 0.0;
+            }
+            if (rounded > 255.0) {
+                rounded = 255.0;
+            }
+            breathe_err_[c] = static_cast<float>(with_err - rounded);
+            out[c] = static_cast<uint8_t>(rounded);
+        }
+
+        StripColor color{out[0], out[1], out[2]};
+        for (int i = 0; i < max_leds_; i++) {
+            WritePixelRaw(i, color);
+        }
+        led_strip_refresh(led_strip_);
+    });
+}
+
+void CircularStrip::SetColorScale(uint8_t percent) {
+    color_scale_ = percent > 100 ? 100 : percent;
+}
