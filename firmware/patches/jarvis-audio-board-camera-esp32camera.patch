+bool Esp32Camera::ApplyOrientation(bool hmirror, bool vflip) {
+    // Gleiche Lage nochmal gesetzt: nichts tun. Sonst baute jedes Verbinden
+    // den Sensor neu auf (deinit/init + Frame-Pruefung, ~5 s) und der
+    // MCP-Handshake liefe in den Timeout.
+    if (orientation_set_ && want_hmirror_ == hmirror && want_vflip_ == vflip) {
+        return true;
+    }
+
+    want_hmirror_ = hmirror;
+    want_vflip_ = vflip;
+    orientation_set_ = true;
+
+    sensor_t* sensor = esp_camera_sensor_get();
+    if (!sensor) {
+        return false;
+    }
+
+    // Waehrend eines laufenden JPEG-Stroms duerfen die Flip-Register nicht
+    // einfach umgestellt werden: belegt am 25.10.2026, danach meldete der
+    // Treiber "NO-SOI - JPEG start marker missing" und das Bild blieb aus.
+    // Deshalb den Strom neu aufsetzen und die Lage danach anwenden.
+    if (streaming_on_) {
+        if (current_fb_) {
+            current_fb_ = nullptr;
+        }
+        esp_camera_deinit();
+        streaming_on_ = false;
+        if (esp_camera_init(&config_) != ESP_OK) {
+            ESP_LOGE(TAG, "Camera re-init for orientation failed");
+            return false;
+        }
+        streaming_on_ = true;
+        sensor = esp_camera_sensor_get();
+        if (!sensor) {
+            return false;
+        }
+    }
+
+    sensor->set_hmirror(sensor, hmirror ? 1 : 0);
+    sensor->set_vflip(sensor, vflip ? 1 : 0);
+    ESP_LOGI(TAG, "Camera orientation applied: hmirror=%d vflip=%d", hmirror, vflip);
+    return true;
+}
+
+bool Esp32Camera::RecoverStream() {
+    // Der DVP-Datenstrom bleibt nach laengerem Leerlauf stehen. Ein Neuaufsetzen
+    // mit derselben Konfiguration holt ihn zurueck; das Geraet laeuft weiter.
+    if (current_fb_) {
+        current_fb_ = nullptr;  // gehoert dem Treiber und wird mit deinit frei
+    }
+    if (streaming_on_) {
+        esp_camera_deinit();
+        streaming_on_ = false;
+    }
+    esp_err_t err = esp_camera_init(&config_);
+    if (err != ESP_OK) {
+        ESP_LOGE(TAG, "Camera re-init failed 0x%x", err);
+        return false;
+    }
+    streaming_on_ = true;
+    if (orientation_set_) {
+        sensor_t* sensor = esp_camera_sensor_get();
+        if (sensor) {
+            sensor->set_hmirror(sensor, want_hmirror_ ? 1 : 0);
+            sensor->set_vflip(sensor, want_vflip_ ? 1 : 0);
+        }
+    }
+    ESP_LOGW(TAG, "Camera stream restarted");
+    return true;
+}
